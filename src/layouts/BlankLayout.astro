---
import RootLayout from "./RootLayout.astro"

interface Props {
  title: string
  description?: string
}

const { title, description } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
const currentYear = new Date().getFullYear()
---

<RootLayout title={`${title} | WildWisdom`} description={description}>
  <header
    class="sticky top-0 z-50 w-full border-b border-slate-200 bg-white shadow-sm backdrop-blur-md"
  >
    <div
      class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6 lg:px-8"
    >
      <div class="flex items-center">
        <a
          href={`${base}`}
          class="group flex items-center transition-transform active:scale-95"
        >
          <img
            src={`${base}/images/WWF_Logo.webp`}
            alt="WildWisdom Logo"
            class="relative top-5 h-20 w-auto object-contain transition-opacity group-hover:opacity-90"
          />
        </a>
      </div>
      <div></div>
    </div>
  </header>

  <main class="relative mx-auto flex w-full flex-1 flex-col">
    <slot />
  </main>

  <footer class="mt-auto w-full bg-black py-6 text-center text-sm text-white">
    <div class="mx-auto max-w-6xl px-6 lg:px-8">
      <p>Copyright &copy; {currentYear} WWF India All Rights Reserved</p>
    </div>
  </footer>
</RootLayout>
