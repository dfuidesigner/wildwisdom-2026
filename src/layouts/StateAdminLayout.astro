---
import RootLayout from "./RootLayout.astro"
import { RoleGuard } from "@/components/auth/RoleGuard"
import { LogoutButton } from "@/components/common/LogoutButton"

interface Props {
  title: string
}
const { title } = Astro.props
const currentYear = new Date().getFullYear()
const base = import.meta.env.BASE_URL
---

<RootLayout
  title={`${title} | State Coordinator`}
  bodyClass="bg-ocean-deep relative flex min-h-screen flex-col font-sans text-white antialiased selection:bg-(--wwf-sea-green)/30 selection:text-white"
>
  <RoleGuard allowedRoles={["state_admin"]} client:only="react">
    <div class="pointer-events-none fixed inset-0 z-0 opacity-20">
      <img
        src={`${base}images/bbg-test.webp`}
        alt="Ocean Background"
        class="h-full w-full object-cover"
      />
      <div
        class="absolute inset-0 bg-linear-to-b from-[var(--wwf-ocean-deep)]/80 via-transparent to-[var(--wwf-ocean-deep)]"
      >
      </div>
    </div>

    <div class="pointer-events-none fixed inset-0 z-0 overflow-hidden">
      <div
        class="absolute top-0 -left-[10%] h-160 w-160 rounded-full bg-(--wwf-sea-green)/10 blur-[120px]"
      >
      </div>
      <div
        class="absolute -right-[5%] bottom-0 h-180 w-180 rounded-full bg-(--wwf-ocean)/15 blur-[130px]"
      >
      </div>
    </div>

    <header
      class="border-ocean/30 sticky top-0 z-40 w-full border-b bg-[var(--wwf-ocean-deep)]/80 shadow-lg backdrop-blur-xl transition-all"
    >
      <div
        class="mx-auto flex h-16 w-full max-w-[95%] items-center justify-between px-6 lg:px-8"
      >
        <div class="flex items-center gap-8">
          <a
            href={`${base}state-admin`}
            class="group flex items-center transition-transform active:scale-95"
          >
            <img
              src={`${base}images/WWF_Logo.webp`}
              alt="WildWisdom Logo"
              class="relative top-5 h-20 w-auto object-contain transition-opacity group-hover:opacity-90"
            />
          </a>
        </div>
        <div class="flex items-center gap-4">
          <div class="hidden text-right sm:block">
            <span
              class="text-sea-green block text-xs font-black tracking-widest uppercase drop-shadow-sm"
              >State Coordinator</span
            >
          </div>
          <div class="bg-ocean/40 hidden h-8 w-px sm:block"></div>
          <LogoutButton client:only="react" />
        </div>
      </div>
    </header>

    <main class="relative z-10 w-full flex-1">
      <slot />
    </main>

    <footer
      class="border-ocean/20 relative z-10 mt-auto w-full border-t bg-[#001a24]/90 py-6 text-center text-sm text-white/60 backdrop-blur-md"
    >
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <p>Copyright &copy; {currentYear} WWF India All Rights Reserved</p>
      </div>
    </footer>
  </RoleGuard>
</RootLayout>
