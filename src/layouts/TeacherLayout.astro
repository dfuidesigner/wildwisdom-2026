---
import RootLayout from "./RootLayout.astro"
import { RoleGuard } from "@/components/auth/RoleGuard"
import { TeacherHeaderAuth } from "@/components/common/TeacherHeaderAuth"

interface Props {
  title: string
}
const { title } = Astro.props
const currentYear = new Date().getFullYear()
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
---

<RootLayout
  title={`${title} | Teacher Portal`}
  bodyClass="flex min-h-screen flex-col bg-(--wwf-white) font-sans text-(--wwf-ocean-deep) antialiased selection:bg-(--wwf-sea-green)/30 selection:text-(--wwf-ocean-deep)"
>
  <RoleGuard allowedRoles={["teacher"]} client:only="react">
    <header
      class="sticky top-0 z-40 w-full bg-white shadow-sm backdrop-blur-md transition-all"
    >
      <div
        class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6 lg:px-8"
      >
        <div class="flex items-center gap-8">
          <a
            href={`${base}/teacher`}
            class="group flex items-center transition-transform active:scale-95"
          >
            <img
              src={`${base}/images/WWF_Logo.webp`}
              alt="WildWisdom Logo"
              class="relative top-5 h-20 w-auto object-contain transition-opacity group-hover:opacity-90"
            />
          </a>
        </div>
        <TeacherHeaderAuth client:only="react" />
      </div>
    </header>

    <main class="mx-auto w-full max-w-7xl flex-1 px-6 py-8 lg:px-8">
      <slot />
    </main>

    <footer class="mt-auto w-full bg-black py-6 text-center text-sm text-white">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <p>Copyright &copy; {currentYear} WWF India All Rights Reserved</p>
      </div>
    </footer>
  </RoleGuard>
</RootLayout>
