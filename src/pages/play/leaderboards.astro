---
import StudentLayout from "@/layouts/StudentLayout.astro"
import { LeaderboardUI } from "@/components/student/LeaderboardUI"
import { RoleGuard } from "@/components/auth/RoleGuard"
import { Trophy } from "lucide-react"
import OceanElement from "@/components/home/OceanElement"

const baseUrl = import.meta.env.BASE_URL
---

<StudentLayout title="Leaderboards">
  <RoleGuard allowedRoles={["student", "teacher", "admin"]} client:only="react">
    <div
      class="relative min-h-screen overflow-hidden"
      style={{
        backgroundImage: `url('${baseUrl}images/oce-new.webp')`,
      }}
    >
      <div class="pointer-events-none absolute inset-0 z-0">
        <div
          class="absolute -top-[10%] -left-[10%] h-120 w-120 rounded-full bg-(--wwf-sea-green)/10 blur-[100px]"
        >
        </div>
        <div
          class="absolute -right-[10%] -bottom-[10%] h-160 w-160 rounded-full bg-(--wwf-ocean-light)/30 blur-[120px]"
        >
        </div>
        <div
          class="absolute top-[40%] left-[20%] h-80 w-[20rem] rounded-full bg-(--wwf-coral)/5 blur-[90px]"
        >
        </div>
        <OceanElement
          client:visible
          src={`${baseUrl}images/svgs/orange-stick.svg`}
          type="float"
          delay={0.2}
          className="absolute right-0 bottom-0 w-12 rotate-y-180! opacity-70 sm:w-20 md:w-30 md:opacity-100 lg:w-30"
        />
        <OceanElement
          client:visible
          src={`${baseUrl}images/svgs/dark-blue-coral.svg`}
          type="coral"
          delay={0.5}
          className="absolute -bottom-16 -left-5 w-25 md:-bottom-25 md:left-5 md:w-40 lg:-bottom-35 lg:left-0 lg:w-auto"
        />
        <OceanElement
          client:visible
          src={`${baseUrl}images/blue-fish.webp`}
          type="fish"
          delay={0}
          className="absolute top-10 left-20 z-0 w-18 sm:left-[40%] md:left-[30%] md:w-25 lg:left-[10%] lg:w-40 xl:top-[40%] xl:left-[3%] xl:w-35"
        />
      </div>
      <div class="relative z-10 px-6 py-8 pt-20 lg:px-20">
        <div class="relative z-10 mb-12">
          <div
            class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between"
          >
            <div>
              <!-- <div class="mb-4 flex items-center gap-1 text-(--wwf-sea-green)">
                <Trophy size={20} className="fill-(--wwf-sea-green)/20" />
                <span class="text-xs font-black tracking-[0.3em] uppercase">
                  Hall of Fame
                </span>
              </div> -->
              <h1
                class="font-wwf text-6xl leading-none font-thin tracking-tight text-white sm:text-7xl md:text-6xl"
              >
                <span class="text-white">Leaderboard</span>
              </h1>
              <p
                class="mt-3 max-w-2xl text-lg leading-relaxed font-medium text-white md:text-xl"
              >
                See how you stack up against your classmates and the rest of the
                world. Only the sharpest minds claim the top spots in the arena.
              </p>
            </div>
          </div>
        </div>
        <LeaderboardUI client:only="react" />
      </div>
    </div>
  </RoleGuard>
</StudentLayout>
