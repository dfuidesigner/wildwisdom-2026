---
import MainLayout from "@/layouts/main.astro"
import { SchoolRegistrationForm } from "@/components/auth/SchoolRegistrationForm"
import InsidePageHero from "@/components/common/InsidePageHero.astro"
import Container from "@/components/common/Container.astro"

// const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "")
---

<MainLayout title="Register School">
  <div
    class="relative flex min-h-[calc(100vh-4rem)] flex-col items-center justify-center overflow-hidden"
  >
    <!-- <InsidePageHero
      heading="Registration for the<br/> Wild Wisdom Global Challenge 2026"
    /> -->
    <InsidePageHero banner="images/banners/banner-3.webp" />
    <!-- <div
      class="fixed inset-0 z-0 bg-cover bg-center bg-no-repeat"
      style={`background-image: url('${baseUrl}/images/last-bg.webp');`}
    >
    </div> -->
    <Container>
      <div
        class="mt-10 mb-50 rounded-[2.5rem] border border-white/20 bg-white/95 p-6 shadow-2xl backdrop-blur-xl sm:p-10"
      >
        <SchoolRegistrationForm client:load />
      </div>
    </Container>
  </div>
</MainLayout>
