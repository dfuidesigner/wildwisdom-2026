---
import { StudentRegistrationForm } from "@/components/auth/StudentRegistrationForm"
import StudentLayout from "@/layouts/StudentLayout.astro"
import OceanElement from "@/components/home/OceanElement"
import AnimatedBossCrab from "@/components/home/AnimatedBossCrab"

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "")
---

<StudentLayout title="Student Registration">
  <div
    class="relative flex min-h-[calc(100vh-4rem)] flex-col items-center justify-center overflow-hidden px-4 py-12 sm:px-6 lg:px-8"
  >
    <div
      class="absolute inset-0 z-0 bg-cover bg-center bg-no-repeat"
      style={`background-image: url('${baseUrl}/images/bb.webp');`}
    >
      <div class="absolute inset-0 bg-(--wwf-ocean-deep)/70 mix-blend-multiply">
      </div>
      <div
        class="absolute inset-0 bg-linear-to-b from-transparent to-(--wwf-ocean-deep)/90"
      >
      </div>
    </div>
    <div class="absolute top-40 right-5 z-19 md:right-[12%]">
      <AnimatedBossCrab client:load />
    </div>

    <OceanElement
      client:visible
      src={`${baseUrl}/images/svgs/dark-blue-coral.svg`}
      type="coral"
      delay={0.6}
      className="absolute -right-5 -bottom-10 w-25 md:right-5 md:-bottom-20 md:w-40 lg:right-0 lg:-bottom-24 lg:w-auto"
    />
    <OceanElement
      client:visible
      src={`${baseUrl}/images/blue-fish.webp`}
      type="fish"
      delay={0.1}
      className="absolute top-24 right-20 z-0 w-18 sm:right-[35%] md:right-[25%] md:w-25 lg:right-[15%] lg:w-40 xl:top-[30%] xl:left-[8%] xl:w-35"
    />

    <OceanElement
      client:visible
      src={`${baseUrl}/images/svgs/dark-cora-right.svg`}
      type="coral"
      delay={0.9}
      className="absolute bottom-5 left-0 w-10 opacity-80 sm:w-15 md:w-20 md:opacity-100 lg:w-auto"
    />
    <OceanElement
      client:visible
      src={`${baseUrl}/images/pink-coral.webp`}
      type="coral"
      delay={1.1}
      className="absolute -bottom-5 -left-5 w-28 md:-bottom-10 md:left-8 md:w-50 lg:-bottom-15 lg:w-auto"
    />

    <div class="relative z-10 w-full max-w-2xl">
      <div class="mb-10 flex flex-col items-center text-center">
        <h2
          class="font-wwf text-4xl tracking-wide text-white drop-shadow-lg sm:text-5xl"
        >
          Student Registration
        </h2>
        <p
          class="mt-3 max-w-xl text-lg font-medium text-(--wwf-orange) drop-shadow-md"
        >
          Enter your school code and create your profile to start playing.
        </p>
      </div>

      <div
        class="rounded-[2.5rem] border border-white/20 bg-white/95 p-6 shadow-2xl backdrop-blur-xl sm:p-10"
      >
        <StudentRegistrationForm client:load />
      </div>

      <div
        class="mt-8 flex flex-col items-center justify-center gap-4 text-sm font-medium text-white/80"
      >
        <div
          class="flex items-center justify-center gap-2 rounded-full bg-black px-6 py-2 backdrop-blur-sm"
        >
          Already have an account?{" "}
          <a
            href={`${baseUrl}/login`}
            class="font-bold text-(--wwf-coral) drop-shadow-sm transition-colors hover:text-(--wwf-orange) hover:underline"
          >
            Sign in here
          </a>
        </div>
      </div>
    </div>
  </div>
</StudentLayout>
