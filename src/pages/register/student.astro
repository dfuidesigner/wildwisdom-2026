---
import StudentLayout from "@/layouts/StudentLayout.astro"
import { LevelSelector } from "@/components/student/LevelSelector"
---

<StudentLayout title="Stage Selection">
  <div class="relative flex min-h-[60vh] flex-col overflow-hidden">
    <!-- Background Blur Effect -->
    <div
      class="absolute -top-40 right-0 -z-10 h-80 w-80 rounded-full bg-emerald-50/50 blur-3xl"
    >
    </div>

    <!-- <LevelSelector client:only="react" /> -->

    <!-- Coming Soon Section -->
    <div
      class="flex flex-1 flex-col items-center justify-center px-4 py-24 text-center"
    >
      <div class="space-y-6">
        <h2 class="text-ocean font-wwf text-5xl tracking-wide md:text-7xl">
          Coming Soon
        </h2>
        <p class="mx-auto max-w-md text-lg md:text-xl">
          We are currently preparing new stages. Check back a little later!
        </p>

        <!-- Optional Decorative Element -->
        <div class="flex justify-center gap-2 pt-4">
          <div class="bg-coral h-2 w-2 animate-pulse rounded-full"></div>
          <div class="bg-coral h-2 w-2 animate-pulse rounded-full delay-75">
          </div>
          <div class="bg-coral h-2 w-2 animate-pulse rounded-full delay-150">
          </div>
        </div>
      </div>
    </div>
  </div>
</StudentLayout>
